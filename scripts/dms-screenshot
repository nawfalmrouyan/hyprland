#!/usr/bin/env bash

scriptsDir="$HOME/.config/hypr/scripts"
rofi_command="vicinae dmenu"

menu() {
  printf "1. Screen now\n"
  printf "2. Window\n"
  printf "3. Area\n"
}

main() {
  choice=$(menu | ${rofi_command} | cut -d. -f1)

  case $choice in
  1)
    sleep 0.5
    dms screenshot full --no-file -f jpg -q 85 --stdout | satty -f -
    return
    ;;
  2)
    sleep 0.5
    dms screenshot window --no-file -f jpg -q 85 --stdout | satty -f -
    return
    ;;
  3)
    sleep 0.5
    dms screenshot region --no-file -f jpg -q 85 --stdout | satty -f -
    return
    ;;
  esac
}

echo "${choice}"
main
