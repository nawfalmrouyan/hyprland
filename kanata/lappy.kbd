(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  danger-enable-cmd yes
  concurrent-tap-hold yes
)

(defvar
  tap-time 300
  hold-time 300
  chord-time 60
)

(defsrc
  esc home del
  grv  1 2 3 4 5 6 7 8 9 0 min eql bspc
  tab q w e r t y u i o p [ ] \
  caps a s d f g h j k l scln ' ret
  lsft z x c v b n m comm . / rsft
  lctl lalt spc ralt rctl
)

(deftemplate charmod (char mod)
  (switch
    ((key-timing 3 less-than 430)) $char break
    () (tap-hold-release-timeout 200 500 $char $mod $char) break
  )
)

;; home row mods
(defalias
mlalt (tap-hold $tap-time $hold-time a lalt)
mlmet (tap-hold $tap-time $hold-time s lmet)
mlsft (tap-hold $tap-time $hold-time d lsft)
mlctl (tap-hold $tap-time $hold-time f lctl)
mrctl (tap-hold $tap-time $hold-time j rctl)
mrsft (tap-hold $tap-time $hold-time k rsft)
mrmet (tap-hold $tap-time $hold-time l rmet)
mralt (tap-hold $tap-time $hold-time scln ralt)
)

(defalias
  game (layer-switch game)
  base (layer-switch base)
  cec (tap-hold-press $tap-time $hold-time esc lctl)
  rec (tap-hold-press $tap-time $hold-time ret lctl)
  hspc (tap-hold $tap-time $hold-time spc (layer-toggle vi))
  htab (tap-hold $tap-time $hold-time tab lmet)
)

;; sub layers
;; (defalias
;;   mdot (tap-hold-release $tap-time $hold-time . (layer-while-held wlkbptr))
;; )


(deflayer base
  esc home del
  grv 1 2 3 4 5 6 7 8 9 0 min eql bspc
  @htab q w e r t y u i o p [ ] \
  @cec
  ;; (t! charmod a lalt)
  ;; (t! charmod s lmet)
  ;; (t! charmod d lsft)
  ;; (t! charmod f lctl)
  @mlalt @mlmet @mlsft @mlctl g h @mrctl @mrsft @mrmet @mralt
  ;; (t! charmod j rctl)
  ;; (t! charmod k rsft)
  ;; (t! charmod l rmet)
  ;; (t! charmod scln ralt)
  ' @rec
  lsft z x c v b n m comm . / rsft
  lctl lalt @hspc ralt rctl
)

(deflayer game
  esc @base del
  grv  1 2 3 4 5 6 7 8 9 0 min eql bspc
  tab q w e r t y u i o p [ ] \
  caps a s d f g h j k l scln ' ret
  lsft z x c v b n m comm . / rsft
  lctl lalt spc ralt @base
 )

(deflayer vi
  M-esc @game M-del
  M-grv M-1 M-2 M-3 M-4 M-5 M-6 M-7 M-8 M-9 M-0 M-min M-eql M-bspc
  M-tab M-q M-w end M-S-r M-C-ret M-y M-u M-i M-o M-p M-[ M-] M-\
  caps home A-s M-S-d M-S-f M-S-g lft down up rght M-scln M-' M-ret
  M-lsft M-z M-x M-c C-S-d M-b M-n M-S-m M-comm M-. M-/ M-rsft
  M-lctl M-lalt - - @game
)

