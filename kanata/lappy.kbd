(defcfg
  process-unmapped-keys yes
  log-layer-changes yes
)

(defvar
  tap-time 200
  hold-time 200
)

(defsrc
  esc home del
  grv  1 2 3 4 5 6 7 8 9 0 min eql bspc
  tab q w e r t y u i o p [ ] \
  caps a s d f g h j k l scln ' ret
  lsft z x c v b n m comm . / rsft
  lctl lalt spc ralt rctl
)

(defalias
  game (layer-switch game)
  base (layer-switch base)
  cec (tap-hold-press $tap-time $hold-time esc lctl)
  rec (tap-hold-press $tap-time $hold-time ret lctl)
  hspc (tap-hold $tap-time $hold-time spc (layer-toggle vi))
  htab (tap-hold $tap-time $hold-time tab lmet)
  ha (tap-hold $tap-time $hold-time a lmet)
  hs (tap-hold $tap-time $hold-time s lalt)
  hd (tap-hold $tap-time $hold-time d lsft)
  hf (tap-hold $tap-time $hold-time f lctl)
  hj (tap-hold $tap-time $hold-time j lctl)
  hk (tap-hold $tap-time $hold-time k lsft)
  hl (tap-hold $tap-time $hold-time l lalt)
  hscln (tap-hold $tap-time $hold-time scln lmet)
)

(deflayer base
  esc home del
  grv 1 2 3 4 5 6 7 8 9 0 min eql bspc
  @htab q w e r t y u i o p [ ] \
  @cec @ha @hs @hd @hf g h @hj @hk @hl @hscln ' @rec
  lsft z x c v b n m comm . / rsft
  lctl lalt @hspc ralt rctl
)

(deflayer game
  esc @base del
  grv  1 2 3 4 5 6 7 8 9 0 min eql bspc
  tab q w e r t y u i o p [ ] \
  caps a s d f g h j k l scln ' ret
  lsft z x c v b n m comm . / rsft
  lctl lalt spc ralt @base
 )

(deflayer vi
  M-esc @game M-del
  M-grv M-1 M-2 M-3 M-4 M-5 M-6 M-7 M-8 M-9 M-0 M-min M-eql M-bspc
  M-tab A-q M-w end M-S-r M-A-ret M-y M-u M-i M-o M-p M-[ M-] M-\
  caps home A-s M-S-d M-S-f M-S-g lft down up rght M-scln M-' M-ret
  M-lsft M-z M-x M-c M-v M-b M-n M-S-m M-comm M-. M-/ M-rsft
  M-lctl M-lalt - - @game
)
