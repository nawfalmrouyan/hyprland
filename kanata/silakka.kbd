(defcfg
  process-unmapped-keys yes
)

(defvar
  tap-time 300
  hold-time 300
  chords-time 60
)

(defsrc
  a s d f j k l scln
)

(deftemplate charmod (char mod)
  (switch
    ((key-timing 3 less-than 430)) $char break
    () (tap-hold-release-timeout 200 500 $char $mod $char) break
  )
)

;; home row mods
(defalias
mlalt (tap-hold $tap-time $hold-time a lalt)
mlmet (tap-hold $tap-time $hold-time s lmet)
mlsft (tap-hold $tap-time $hold-time d lsft)
mlctl (tap-hold $tap-time $hold-time f lctl)
mrctl (tap-hold $tap-time $hold-time j rctl)
mrsft (tap-hold $tap-time $hold-time k rsft)
mrmet (tap-hold $tap-time $hold-time l rmet)
mralt (tap-hold $tap-time $hold-time scln ralt)
)

(deflayer base
  @mlalt @mlmet @mlsft @mlctl g h @mrctl @mrsft @mrmet @mralt
)

