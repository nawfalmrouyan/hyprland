(defcfg
  process-unmapped-keys yes
  log-layer-changes no
  danger-enable-cmd yes
  concurrent-tap-hold yes
)

(defvar
  tap-time 300
  hold-time 300
  chords-time 60
)

(defsrc
  tab a s d f j k l scln
)

;; home row mods
(defalias
mtab (tap-hold $tap-time $hold-time tab lmet)
mlalt (tap-hold $tap-time $hold-time a lalt)
mlmet (tap-hold $tap-time $hold-time s lmet)
mlsft (tap-hold $tap-time $hold-time d lsft)
mlctl (tap-hold $tap-time $hold-time f lctl)
mrctl (tap-hold $tap-time $hold-time j rctl)
mrsft (tap-hold $tap-time $hold-time k rsft)
mrmet (tap-hold $tap-time $hold-time l rmet)
mralt (tap-hold $tap-time $hold-time scln ralt)
)

(deflayer base
  @mtab @mlalt @mlmet @mlsft @mlctl @mrctl @mrsft @mrmet @mralt
)

(defchordsv2
  (spc j k) C-\ $chords-time first-release () ;; tmux prefix
  (spc d f) (cmd vicinae toggle) $chords-time first-release () ;; vicinae
  (d f) A-C-s $chords-time first-release () ;; zen toggle floating side bar
  (w e) A-C-q $chords-time first-release () ;; zen previous workspace
  (i o) A-C-e $chords-time first-release () ;; zen next workspace
)
